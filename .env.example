# =============================================================================
# VyomPath — Runtime Environment Configuration Example
# =============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env
# =============================================================================

# Public-facing port for Nginx frontend and reverse proxy (default 8080)
PORT=8080

# Backend allowed CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Optional: Path to external Float32 HiRISE Jezero DTM GeoTIFF
# Leave unset or empty for DEVELOPMENT / MOCK backend mode.
# Inside Docker, if mounted into /app/data:
# VYOMPATH_DEM_PATH=/app/data/dtm/jezero_aoi_v2.tif

# Optional: Local host directory mounted to /app/data:ro inside the backend container
# LOCAL_DATA_DIR=./data
