# Auto-detect text files and normalize line endings to LF on checkout
* text=auto eol=lf

# Windows-specific script files retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts and python files use LF
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Packaging exclusions for unverified third-party telemetry (Issue #11)
data/M20_waypoints.json export-ignore
tests/fixtures/golden_pois.json export-ignore
tests/fixtures/validation/ export-ignore


